[connection]
id=weblink-ap
uuid=f100294a-0197-4baf-ab38-c6de9922d944
type=wifi
autoconnect=false
interface-name=uap0

[wifi]
band=bg
channel=6
mode=ap
ssid=WebLink

[wifi-security]
key-mgmt=wpa-psk
psk=weblink1234

[ipv4]
address1=192.168.42.2/24
method=shared

[ipv6]
addr-gen-mode=default
method=auto

[proxy]
